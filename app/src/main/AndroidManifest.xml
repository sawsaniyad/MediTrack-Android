<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.samiraa_raghadm_sawsana.meditrack">

    <!-- הרשאות נדרשות -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediTrack"
        android:name=".MediTrackApplication">


        <!-- SplashActivity - נקודת הכניסה לאפליקציה -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MediTrack">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- שאר המסכים -->
        <activity
            android:name=".activities.MedicationListActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AddEditMedicationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MedicationListActivity" />

        <activity
            android:name=".activities.HistoryActivity"
            android:exported="false"
            android:parentActivityName=".activities.MedicationListActivity" />

        <!-- AlarmReceiver - מקבל התראות מ-AlarmManager -->
        <receiver
            android:name=".receivers.AlarmReceiver"
            android:exported="false" />

        <!-- BootReceiver - מתזמן מחדש לאחר הפעלת מכשיר -->
        <receiver
            android:name=".receivers.BootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receivers.TakenActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".receivers.SnoozeActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".receivers.MissedDoseReceiver"
            android:exported="false" />

        <receiver
            android:name=".receivers.ExpiryReceiver"
            android:exported="false" />

        <!-- FileProvider - לשמירת תמונות מהמצלמה -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.samiraa_raghadm_sawsana.meditrack.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
