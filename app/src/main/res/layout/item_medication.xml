<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    android:layoutDirection="rtl"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivMedicationImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#E3F2FD"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvMedicationName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="#212121"
            android:textDirection="locale"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/viewStatusBadge"
            app:layout_constraintStart_toEndOf="@+id/ivMedicationImage"
            app:layout_constraintTop_toTopOf="@+id/ivMedicationImage" />

        <TextView
            android:id="@+id/tvDosage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="#757575"
            android:textDirection="locale"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@+id/tvMedicationName"
            app:layout_constraintStart_toStartOf="@+id/tvMedicationName"
            app:layout_constraintTop_toBottomOf="@+id/tvMedicationName" />

        <LinearLayout
            android:id="@+id/llNextTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@+id/tvDosage"
            app:layout_constraintStart_toStartOf="@+id/tvDosage"
            app:layout_constraintTop_toBottomOf="@+id/tvDosage">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="3dp"
                android:src="@android:drawable/ic_menu_recent_history"
                android:tint="#1976D2" />

            <TextView
                android:id="@+id/tvNextTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:textColor="#1976D2"
                android:textDirection="locale"
                android:textSize="11sp" />

        </LinearLayout>

        <View
            android:id="@+id/viewStatusBadge"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_status_badge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="end"
            android:textAlignment="viewEnd"
            android:textColor="#757575"
            android:textDirection="locale"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viewStatusBadge" />

        <LinearLayout
            android:id="@+id/llQuickActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llNextTime">

            <TextView
                android:id="@+id/btnMarkTaken"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="#E8F5E9"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="V"
                android:textColor="#2E7D32"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnMarkMissed"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="#FFEBEE"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="X"
                android:textColor="#C62828"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSnooze"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="#FFF8E1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⏰"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
